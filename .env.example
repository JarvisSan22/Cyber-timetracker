# Copy to .env and adjust. docker compose reads .env automatically.

# Host port the app is served on: http://<pi-ip>:8686
TRACKER_PORT=8686

# Default timezone until you pick one in Settings.
TZ=Asia/Tokyo

# Host user that owns ./data. Run `id -u` and `id -g` on the Pi (usually 1000).
PUID=1000
PGID=1000

# 1 = add demo projects and sessions on first run (empty database only).
SEED_DEMO=0
