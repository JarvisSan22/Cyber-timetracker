{
  "manifest_version": 3,
  "name": "Cyber Miner",
  "short_name": "Cyber Miner",
  "version": "0.11.0",
  "description": "Mine Anki sentence cards from YouTube and Netflix subtitles, and log watch time to Cyber Tracker.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cyber Miner",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "sidePanel",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/page-hook.js",
        "content/hooks/youtube.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content/page-hook.js",
        "content/hooks/netflix.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*",
        "shared/*",
        "styles/overlay.css",
        "vendor/augmented-ui.min.css",
        "vendor/fonts/*"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.netflix.com/*"
      ]
    }
  ],
  "commands": {
    "mine-card": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Mine the current subtitle line (opens the card panel)"
    },
    "quick-mine": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Quick mine: send the current line without the panel"
    },
    "replay-line": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Replay the current subtitle line"
    },
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Translation line: blurred, shown, hidden"
    }
  }
}
