<?xml version="1.0" encoding="utf-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" ttp:tickRate="10000000" xml:lang="ja">
  <head>
    <styling>
      <style xml:id="s0" tts:fontSize="100%"/>
      <style xml:id="rubyBase" tts:ruby="base"/>
      <style xml:id="rubyText" tts:ruby="text" tts:fontSize="50%"/>
      <style xml:id="rubyTextAlias" style="rubyText"/>
      <style xml:id="rubyCont" tts:ruby="container"/>
    </styling>
  </head>
  <body>
    <div>
      <p begin="12345670000t" end="12678900000t" style="s0">
        <span style="rubyCont"><span style="rubyBase">魔法</span><span style="rubyText">まほう</span></span>は
        <span style="rubyCont"><span style="rubyBase">好</span><span style="rubyTextAlias">す</span></span>きだ<br/>（フリーレン）お茶&amp;お菓子
      </p>
      <p begin="10000000t" end="25000000t"><span tts:ruby="container"><span tts:ruby="base">一</span><span tts:ruby="text">いち</span></span>番目</p>
      <p begin="30000000t" end="30000000t">empty duration</p>
    </div>
  </body>
</tt>
